<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration of SSS (in-process hosting). The handler is deliberately NOT wrapped in
  <location path="." inheritInChildApplications="false">: such a block does not reach configuration nodes that
  IIS creates for a sub path (for example the anonymous health probe /healthz), which then answer 404.
  SSS has no child applications, so nothing needs protecting from inheritance.
  Clickjacking: the application already sends Content-Security-Policy frame-ancestors 'none'; X-Frame-Options is the
  equivalent for old browsers and what code scanning looks for in this file. (Set here only, so the header is not sent twice.)
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <httpProtocol>
      <customHeaders>
        <add name="X-Frame-Options" value="DENY" />
      </customHeaders>
    </httpProtocol>
    <aspNetCore processPath=".\Sss.Web.exe" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
  </system.webServer>
</configuration>
