{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Sss": {
    "Provider": "Mock",
    "RefreshSeconds": 30,
    "Auth": { "Mode": "Iis" },
    "Audit": { "Directory": "logs" },
    "RateLimit": { "LogoffRequestsPerMinute": 10 },
    "Quality": {
      "RttWarnMs": 80,
      "RttCritMs": 150,
      "BandwidthWarnKbps": 1500,
      "BandwidthCritKbps": 400,
      "LogonWarnSeconds": 45,
      "LogonCritSeconds": 90,
      "LoadWarn": 7000,
      "LoadCrit": 9000
    }
  }
}
