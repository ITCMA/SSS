{
  "$schema": "../sss.config.schema.json",
  "Sss": {
    "Provider": "Citrix",
    "Citrix": {
      "Controllers": [ "ddc01.corp.local" ],
      "Discovery": { "Enabled": true, "RefreshMinutes": 15 },
      "Balancing": { "Strategy": "LeastLatency", "Preferred": [ "DC1" ] },
      "Processes": { "Enabled": true, "Audience": "Helpdesk" }
    },
    "Roles": {
      "Level1Group": "CORP\\SSS-Helpdesk-L1",
      "Level2Group": "CORP\\SSS-Helpdesk-L2",
      "Level3Group": "CORP\\SSS-Helpdesk-L3",
      "AuditorGroup": "CORP\\SSS-Auditors",
      "AdminGroup": "CORP\\SSS-Admins"
    },
    "Helpdesk": { "ReasonRequired": true, "BulkAlertThreshold": 5 },
    "Audit": {
      "PerServerFiles": true,
      "RetentionDays": 90,
      "Sinks": {
        "Unc": [
          { "Path": "\\\\fs01.corp.local\\sss-audit" }
        ],
        "Syslog": [
          { "Host": "siem01.corp.local", "Protocol": "Tls", "Format": "Cef" }
        ],
        "Http": [
          {
            "Name": "teams-alerts",
            "Url": "https://example.webhook.office.com/webhookb2/replace-me",
            "Format": "Text",
            "Include": [ "alert:" ],
            "OnlyProblems": true
          }
        ]
      }
    },
    "Environment": {
      "Locations": [
        { "Name": "Head office", "Networks": [ "10.20.0.0/16" ] },
        { "Name": "Branch office", "Networks": [ "10.30.0.0/16", "192.0.2.0/24" ] },
        { "Name": "Home office (VPN)", "Networks": [ "10.99.0.0/16" ] }
      ],
      "MinClientVersion": { "Windows": "26.3.0", "*": "26.3.0" }
    },
    "Metrics": { "Enabled": true, "AllowedIps": [ "10.0.5.0/24" ] }
  }
}
